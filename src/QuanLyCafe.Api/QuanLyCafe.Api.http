@QuanLyCafe.Api_HostAddress = http://localhost:5254
# Dán token từ response login vào đây
@token =

GET {{QuanLyCafe.Api_HostAddress}}/health

###

POST {{QuanLyCafe.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{ "username": "manager", "password": "<mật khẩu trong user-secrets Seed:ManagerPassword>" }

###

POST {{QuanLyCafe.Api_HostAddress}}/api/auth/change-password
Authorization: Bearer {{token}}
Content-Type: application/json

{ "currentPassword": "...", "newPassword": "..." }

###

### Ordering — đăng nhập Waiter/Cashier lấy token

GET {{QuanLyCafe.Api_HostAddress}}/api/tables
Authorization: Bearer {{token}}

###

# orderType: 1 tại bàn (cần tableId), 2 mang đi
POST {{QuanLyCafe.Api_HostAddress}}/api/orders
Authorization: Bearer {{token}}
Content-Type: application/json

{ "orderType": 1, "tableId": "<id bàn từ GET /api/tables>" }

###

@orderId = <id từ POST /api/orders>

GET {{QuanLyCafe.Api_HostAddress}}/api/orders/{{orderId}}
Authorization: Bearer {{token}}

###

# Thay toàn bộ món còn "Chờ"; gửi [] để xóa hết món chờ
PUT {{QuanLyCafe.Api_HostAddress}}/api/orders/{{orderId}}/items
Authorization: Bearer {{token}}
Content-Type: application/json

{ "items": [ { "productId": "<id sản phẩm>", "quantity": 2, "note": "ít đá" } ] }

###

@materialId = <dán materialId thật>

GET {{QuanLyCafe.Api_HostAddress}}/api/materials
Authorization: Bearer {{token}}

###

POST {{QuanLyCafe.Api_HostAddress}}/api/stock/receipts
Authorization: Bearer {{token}}
Content-Type: application/json

{ "materialId": "{{materialId}}", "quantity": 100, "note": "Test nhập kho" }

###

POST {{QuanLyCafe.Api_HostAddress}}/api/stock/issues
Authorization: Bearer {{token}}
Content-Type: application/json

{ "materialId": "{{materialId}}", "quantity": 30, "note": "Test xuất kho" }

###

GET {{QuanLyCafe.Api_HostAddress}}/api/stock/movements?page=1&pageSize=1
Authorization: Bearer {{token}}

###

POST {{QuanLyCafe.Api_HostAddress}}/api/stock/stocktakes
Authorization: Bearer {{token}}
Content-Type: application/json

{ "materialId": "{{materialId}}", "actualQuantity": 50, "note": "Kiểm kê cuối ca" }

### Thanh toán tiền mặt — dùng token Cashier hoặc Manager và orderId của đơn đang mở có món đã thiết lập BOM.
# Thử tiền thiếu trước, rồi sửa cashGiven thành số đủ và gửi lại. Gửi lại với cashGiven khác để kiểm tra tiền thối gốc và số phiếu kho.

POST {{QuanLyCafe.Api_HostAddress}}/api/payments
Authorization: Bearer {{token}}
Content-Type: application/json

{ "orderId": "{{orderId}}", "method": 1, "cashGiven": 100000 }

### Thanh toán điện tử giả lập — MoMo = 2, VNPay = 3, Thẻ = 4.
# Dùng đơn đang mở. Khởi động API với PaymentGateway__Mode = Success, Declined hoặc Timeout.
# Declined và Timeout phải trả 502 / ERR-PAY-001. Timeout mất khoảng 15 giây.

POST {{QuanLyCafe.Api_HostAddress}}/api/payments
Authorization: Bearer {{token}}
Content-Type: application/json

{ "orderId": "{{orderId}}", "method": 2 }
