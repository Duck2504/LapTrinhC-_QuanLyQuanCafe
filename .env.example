# Chép thành file .env rồi đổi giá trị. File .env KHÔNG được commit (đã có trong .gitignore).

# Mật khẩu SQL Server (tài khoản sa): >= 8 ký tự, có chữ hoa, chữ thường, số và ký tự đặc biệt.
# Không dùng dấu ; " hoặc $ (làm hỏng chuỗi kết nối / bị Docker Compose hiểu là biến).
SA_PASSWORD=Doi_Mat_Khau_123

# Khóa ký JWT: chuỗi ngẫu nhiên >= 32 ký tự. Tạo nhanh: openssl rand -base64 48
JWT_KEY=thay-bang-chuoi-ngau-nhien-it-nhat-32-ky-tu

# Mật khẩu tài khoản "manager" tạo lần chạy đầu tiên (đăng nhập xong nên đổi ngay).
MANAGER_PASSWORD=Doi_Mat_Khau_456

# Cổng API trên máy chủ (Desktop trỏ tới http://<địa-chỉ-máy>:<API_PORT>).
API_PORT=8080

# Chỉ dùng với: docker compose --profile https up -d — tên miền đã trỏ DNS về VPS.
DOMAIN=
